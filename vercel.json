{
  "redirects": [{ "source": "/app", "destination": "/app/", "permanent": false }],
  "rewrites": [{ "source": "/((?!app/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/app/(.*)\\.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }, { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/app/(.*)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/app/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
